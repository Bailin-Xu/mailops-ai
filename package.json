{
  "name": "mailops-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/run-integration-tests.ts",
    "demo:seed": "tsx scripts/seed-demo.ts",
    "eml:scan": "tsx scripts/scan-eml.ts",
    "eml:import": "tsx scripts/import-eml-directory.ts",
    "eml:demo:seed": "tsx scripts/seed-synthetic-known-question-emails.ts",
    "eml:clean:backfill": "tsx scripts/backfill-clean-bodies.ts",
    "eml:direction:backfill": "tsx scripts/backfill-email-directions.ts",
    "eml:knowledge:prescreen": "tsx scripts/prescreen-knowledge-sources.ts",
    "eml:threads:plan": "tsx scripts/plan-thread-reconstruction.ts",
    "website:review:seed": "tsx scripts/seed-website-knowledge-review.ts",
    "knowledge:candidates:import": "tsx scripts/import-knowledge-candidates.ts",
    "knowledge:candidates:clean": "tsx scripts/backfill-email-candidates.ts",
    "ai:gemini:smoke": "tsx scripts/smoke-gemini.ts",
    "ai:eval:synthetic": "tsx scripts/run-synthetic-ai-evaluation.ts",
    "ai:eval:holdout": "tsx scripts/run-synthetic-holdout.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:validate": "prisma validate",
    "postinstall": "prisma generate",
    "ai:eval": "tsx scripts/run-ai-benchmark.ts",
    "test:e2e": "tsx scripts/run-browser-tests.ts",
    "eml:threads:reconstruct": "tsx scripts/reconstruct-threads.ts",
    "bench:threads": "tsx scripts/benchmark-threads.ts",
    "agent:fixtures": "tsx scripts/agent/fixtures.ts",
    "agent:contracts:python": "services/agent/.venv/bin/python services/agent/contracts.py",
    "agent:mcp:test": "tsx scripts/agent/test-mcp.ts",
    "agent:mcp": "tsx services/mcp/start.ts",
    "agent:workflow:test": "tsx scripts/agent/test-mcp.ts --agent",
    "agent:check": "services/agent/.venv/bin/ruff check services/agent && services/agent/.venv/bin/mypy --config-file services/agent/pyproject.toml services/agent && services/agent/.venv/bin/pytest -c services/agent/pyproject.toml && npm run agent:contracts:python",
    "agent:durable:test": "tsx scripts/agent/test-durable.ts",
    "agent:checkpoint:setup": "services/agent/.venv/bin/python services/agent/store.py",
    "agent:upgrade:test": "tsx scripts/agent/test-upgrade.ts",
    "agent:eval:mock": "tsx scripts/agent/evaluate-mock.ts",
    "agent:review:prepare": "tsx scripts/agent/prepare-review.ts",
    "agent:review:score": "tsx scripts/agent/score-review.ts",
    "agent:review:render": "tsx scripts/agent/render-review.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "html-to-text": "^10.0.0",
    "next": "16.2.12",
    "pg": "^8.22.0",
    "postal-mime": "^3.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^20",
    "@types/pg": "^8.20.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
