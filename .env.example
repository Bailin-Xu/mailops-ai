# Local PostgreSQL database started by docker-compose.yml
DATABASE_URL="postgresql://mailops:mailops_dev@localhost:5433/mailops?schema=public"

# Dedicated disposable database: docker compose --profile test up -d postgres-test
# Integration tests never fall back to DATABASE_URL. Both the role and DB must be mailops_test.
TEST_DATABASE_URL="postgresql://mailops_test:mailops_test_local@127.0.0.1:5434/mailops_test?schema=public"

# Keep local development and automated tests deterministic by default.
# Change to "gemini" only after configuring both Gemini values below.
AI_PROVIDER="mock"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Defense-in-depth delivery controls. Local development must keep these defaults.
SHADOW_MODE="true"
EXTERNAL_DELIVERY_ENABLED="false"
AUTO_REPLY_MIN_CONFIDENCE="0.90"

# 10 MiB, matching FR-011.
EMAIL_IMPORT_MAX_BYTES="10485760"

# Comma-separated mailbox identities used to classify email direction.
MAILOPS_OWNED_EMAIL_ADDRESSES="support@example.com"
