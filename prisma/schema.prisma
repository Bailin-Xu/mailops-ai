generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model EmailThread {
  id                String         @id @default(uuid()) @db.Uuid
  subject           String
  normalizedSubject String
  status            String         @default("NEW")
  language          String?
  isIncomplete      Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  messages          EmailMessage[]

  @@index([status])
  @@index([createdAt])
}

model EmailMessage {
  id             String      @id @default(uuid()) @db.Uuid
  threadId       String      @db.Uuid
  messageId      String?     @unique
  inReplyTo      String?
  references     String[]    @default([])
  subject        String
  sentAt         DateTime?
  textBody       String?
  htmlBody       String?
  normalizedBody String
  sourceFileName String
  fingerprint    String      @unique
  parseStatus    String      @default("PARSED")
  parseWarnings  String[]    @default([])
  createdAt      DateTime    @default(now())
  thread         EmailThread @relation(fields: [threadId], references: [id], onDelete: Restrict)

  @@index([threadId, sentAt])
  @@index([sentAt])
}
